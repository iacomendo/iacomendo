# ============================================================
# Comendo MKT — variáveis de ambiente (TEMPLATE)
# ============================================================
# Copie este arquivo para `.env` e preencha com os valores reais.
# O `.env` está no .gitignore — NUNCA é versionado.
# Em produção (nuvem), defina estas variáveis no secret store do provedor,
# não em arquivo.
#
# ⚠️ Os valores abaixo são PLACEHOLDERS. As chaves reais que já existiam
#    hardcoded no código devem ser ROTACIONADAS (geradas de novo) antes de ir
#    pra produção, porque trafegaram em texto puro.
# ============================================================

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-troque-esta-chave
# Opcional: modelo do resumo (default claude-sonnet-4-6). Avaliar claude-sonnet-5.
# CLAUDE_MODEL=claude-sonnet-4-6

# ---- Evolution API (WhatsApp) ----
# Local (dev): http://localhost:8080
# Nuvem: a URL pública do servidor Evolution, ex: https://evolution.suaempresa.com
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave-da-evolution
# EVOLUTION_INSTANCIA=comendo

# ---- Google (Gmail + Drive) — fluxo Dashgoo ----
# Modo LOCAL (arquivos no disco): deixe as *_PATH e coloque os arquivos na pasta.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
# Modo NUVEM (conteúdo em env var): cole o JSON inteiro numa linha só.
# GOOGLE_CREDENTIALS_JSON={"installed":{...}}
# GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"..."}
# REMETENTE_RELATORIO=no-reply@mg.dashgoo.com
# DIAS_RECENTES=7
# PASTA_MAE_DRIVE=Relatórios MLabs

# ---- Banco de dados ----
# Local (hoje): SQLite. Deixe DB_PATH em branco pra usar clientes.db ao lado do código,
# ou aponte pra outro caminho.
# DB_PATH=clientes.db
# Nuvem (Postgres/Supabase): defina DATABASE_URL e o comendo_db usa Postgres.
# DATABASE_URL=postgresql://usuario:senha@host:5432/comendo

# ---- Saída local das mensagens ----
# PASTA_SAIDA_MENSAGENS=./relatorios_saida

# ---- Painel web ----
# Local: 127.0.0.1. Nuvem: 0.0.0.0 (atrás do HTTPS do provedor).
# PAINEL_HOST=127.0.0.1
# PORT=8077

# ---- Gestores (fallback — fonte da verdade é a tabela `gestores`) ----
# NUMEROS_GESTORES=Yago=5519999167515,Joao=5519995336044
# MEU_NUMERO=5519999167515
